              "type": "m",
              "expression": [
                "let",
                "    Encoded = Text.Combine({\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"OnVKScHWA4J0IbDe6WI6tmPI+qiIEVJhSb1+5/Ct63wkwjAtIOvxvVQPRAXvvQ9FHHp2QHATVC+26YZGODPpXd270YKO05PP8Yv0Ko6qzD10ZzrXQBRch33CXTbQuVxC/8i5reH/SmOicZcOEJ7prh34fw==\"}),",
                "    Bytes = Binary.Decompress(Binary.FromText(Encoded, BinaryEncoding.Base64), Compression.Deflate),",
                "    Source = Csv.Document(Bytes, [Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"comment_id\", type text}, {\"artist\", type text}, {\"video_id\", type text}, {\"video_title\", type text}, {\"search_term\", type text}, {\"comment_text\", type text}, {\"author_channel_id\", type text}, {\"like_count\", Int64.Type}, {\"published_at\", type text}, {\"collection_date\", type text}, {\"source\", type text}}, \"en-US\")",
