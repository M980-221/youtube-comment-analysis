        "measures": [
          {
            "name": "Comment count",
            "expression": "COUNTROWS(Comments)",
            "description": "Number of collected comments.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "2e35999b-f701-5aba-93a3-1097d251e688",
            "formatString": "#,0"
          },
          {
            "name": "Unique commenters",
            "expression": "DISTINCTCOUNT(Comments[author_channel_id])",
            "description": "Distinct channel IDs across the selected artists; shared commenters are counted once.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "3013ba64-b33c-5d75-8cea-5cad9246a514",
            "formatString": "#,0"
          },
          {
            "name": "Videos",
            "expression": "DISTINCTCOUNT(Comments[video_id])",
            "description": "Distinct videos in the selection.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "2c1215eb-2559-5b2b-bcbf-c7fbe91a7ec7",
            "formatString": "#,0"
          },
          {
            "name": "Liked comments",
            "expression": "CALCULATE([Comment count], Comments[like_count] > 0)",
            "description": "Comments with at least one recorded like.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "f9137c93-8f6a-590c-8afe-c4e7b0b37079",
            "formatString": "#,0"
          },
          {
            "name": "Comments with likes",
            "expression": "DIVIDE([Liked comments], [Comment count])",
            "description": "Share of sampled comments with at least one recorded like.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "b6becbcc-cbcf-5ad5-bd35-c2aee0c89772",
            "formatString": "0.00%"
          },
          {
            "name": "Average likes",
            "expression": "AVERAGE(Comments[like_count])",
            "description": "Mean likes per sampled comment. Sensitive to unusually popular comments.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "4db5138a-be33-5ebe-b85d-6071232c45eb",
            "formatString": "0.00"
          },
          {
            "name": "Median likes",
            "expression": "MEDIAN(Comments[like_count])",
            "description": "Median likes per sampled comment.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "a8fa23b2-0139-54da-befc-5d6fe4d827c7",
            "formatString": "0.0"
          },
          {
            "name": "Positive",
            "expression": "SUM(Sentiment_Artists[positive_comments])",
            "description": "Positive comments from the supplied Q9 analysis.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "a5798ba2-7d5b-5703-ba1c-c9284e0ac03e",
            "formatString": "#,0"
          },
          {
            "name": "Neutral",
            "expression": "SUM(Sentiment_Artists[neutral_comments])",
            "description": "Neutral comments from the supplied Q9 analysis.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "592e101c-2ff6-50d4-9b26-dee897a12ef0",
            "formatString": "#,0"
          },
          {
            "name": "Negative",
            "expression": "SUM(Sentiment_Artists[negative_comments])",
            "description": "Negative comments from the supplied Q9 analysis.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "1f8d5051-0582-524b-9bc9-bb3c2777aa3a",
            "formatString": "#,0"
          },
          {
            "name": "Mean sentiment",
            "expression": "DIVIDE(SUMX(Sentiment_Artists, Sentiment_Artists[mean_sentiment] * Sentiment_Artists[total_comments]), SUM(Sentiment_Artists[total_comments]))",
            "description": "Comment-weighted mean sentiment from Q9.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "70064fee-bca1-54a9-becd-d0cf53da2fe8",
            "formatString": "0.000"
          },
          {
            "name": "Repeat commenters",
            "expression": "DIVIDE(SUM(Unique_Actors[repeat_actors]), SUM(Unique_Actors[unique_actors]))",
            "description": "Within each artist dataset, share of actors who made more than one comment.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "d60b2476-b4ab-596c-987b-ad62cc0b16c7",
            "formatString": "0.00%"
          },
          {
            "name": "Comments from repeat commenters",
            "expression": "DIVIDE(SUM(Unique_Actors[total_comments]) - SUM(Unique_Actors[single_comment_actors]), SUM(Unique_Actors[total_comments]))",
            "description": "Within each artist dataset, share of comments contributed by actors with more than one comment.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "240ffff2-ebc1-55d6-8c7b-c77bc729f007",
            "formatString": "0.0%"
          },
          {
            "name": "Listed term frequency",
            "expression": "SUM(Top_Terms[frequency])",
            "description": "Occurrences only in the supplied top-ten-term lists, not the complete vocabularies.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "9536fdac-5d4d-5fe0-a4be-02d8ef7a35f8",
            "formatString": "#,0"
          },
          {
            "name": "Top 10 listed terms",
            "expression": [
              "VAR CurrentTerm = SELECTEDVALUE(Top_Terms[term])",
              "VAR TopTerms = TOPN(10, ALLSELECTED(Top_Terms[term]), CALCULATE([Listed term frequency]), DESC, Top_Terms[term], ASC)",
              "RETURN IF(CONTAINS(TopTerms, Top_Terms[term], CurrentTerm), [Listed term frequency])"
            ],
            "description": "Ten highest frequencies in the selected supplied shortlists. Artist slicer restores the original per-artist top ten.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "eb4a370b-3e13-5fe6-9139-ece87cc21507",
            "formatString": "#,0"
          },
          {
            "name": "Emotion matches per 1000",
            "expression": "DIVIDE(SUM(Emotions[emotion_count]) * 1000, [Comment count])",
            "description": "NRC emotion matches per 1,000 comments. Emotions can overlap within a comment.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "42e34465-e7ec-5984-81ca-e8b06d89255d",
            "formatString": "0.0"
          },
          {
            "name": "Community modularity",
            "expression": "AVERAGE(Communities[modularity])",
            "description": "Weighted modularity for the artist and algorithm, calculated on the active-actor networks used in Q8.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "c1d789eb-eb8c-568c-8da2-4e6948bf18a9",
            "formatString": "0.000"
          },
          {
            "name": "Community count",
            "expression": "SUM(Communities[communities])",
            "description": "Communities for the artist and algorithm.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "2e43285b-f322-50c4-87ca-8f83288bc304",
            "formatString": "#,0"
          },
          {
            "name": "Dominant topic documents",
            "expression": "SUM(Topics[dominant_documents])",
            "description": "Documents assigned to their most probable topic, among documents retained for LDA.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "bed21389-d79f-5812-8fa4-f982eb1cdfb3",
            "formatString": "#,0"
          },
          {
            "name": "Topic terms",
            "expression": "SELECTEDVALUE(Topics[top_terms])",
            "description": "Top words for the hovered artist-specific topic.",
            "displayFolder": "Dashboard measures",
            "lineageTag": "b535a949-49e3-5f85-ab59-620b2dde8de2"
          },
          {
            "name": "Top ten comment count",
            "expression": [
              "SUMX(",
              "    VALUES(Artists[artist]),",
              "    VAR ActorCounts = CALCULATETABLE(",
              "        ADDCOLUMNS(VALUES(Comments[author_channel_id]),",
              "            \"__CommentCount\", CALCULATE(COUNTROWS(Comments))))",
              "    VAR LeadingActors = TOPN(10, ActorCounts, [__CommentCount], DESC, Comments[author_channel_id], ASC)",
              "    RETURN SUMX(LeadingActors, [__CommentCount])",
              ")"
            ],
            "formatString": "#,0",
            "description": "Sum of comments from exactly ten highest-count actors per selected artist; channel ID breaks ties.",
            "displayFolder": "Q12 measures",
            "lineageTag": "546b5c7b-305a-5551-b9c4-68d22530973b"
          },
          {
            "name": "Top ten comment share",
            "expression": "DIVIDE([Top ten comment count], [Comment count])",
            "formatString": "0.00%",
            "description": "Top ten contributors per artist divided by that artist sample; pooled totals sum artist-level numerators.",
            "displayFolder": "Q12 measures",
            "lineageTag": "2b289f29-0f5b-5059-937f-74f4573351c7"
          },
          {
            "name": "Maximum weighted degree",
            "expression": "MAX(Centrality[maximum_weighted_degree])",
            "formatString": "#,0",
            "description": "Maximum comments made by one actor in the artist sample.",
            "displayFolder": "Q12 measures",
            "lineageTag": "8a42c203-bafb-5cdf-847e-0180dc4239a6"
          },
          {
            "name": "Maximum betweenness",
            "expression": "MAX(Centrality[maximum_betweenness])",
            "formatString": "0.0000",
            "description": "Maximum actor betweenness from Q7, using inverse-weight distances.",
            "displayFolder": "Q12 measures",
            "lineageTag": "8ba78691-ce67-54c1-9bcd-244f134b81e8"
          },
          {
            "name": "Louvain modularity",
            "expression": "CALCULATE(AVERAGE(Communities[modularity]), Communities[algorithm] = \"Louvain\")",
            "formatString": "0.0000",
            "description": "Q8 Louvain modularity on the active actor subset.",
            "displayFolder": "Q12 measures",
            "lineageTag": "ff6fd042-44e9-5d23-a049-3b679768435a"
          },
          {
            "name": "Girvan Newman modularity",
            "expression": "CALCULATE(AVERAGE(Communities[modularity]), Communities[algorithm] = \"Girvan-Newman\")",
            "formatString": "0.0000",
            "description": "Required-method comparator in modularity tooltips.",
            "displayFolder": "Q12 measures",
            "lineageTag": "11fc3ae3-4bc6-59ed-b6e5-cc885c8c054f"
          },
          {
            "name": "Topic 1 documents",
            "expression": "CALCULATE(SUM(Topics[dominant_documents]), Topics[topic] = 1)",
            "formatString": "#,0",
            "description": "Dominant topic 1 count; theme is specific to each artist.",
            "displayFolder": "Q12 measures",
            "lineageTag": "5355f7c6-930b-546b-86c5-d80d9aa32428"
          },
          {
            "name": "Topic 2 documents",
            "expression": "CALCULATE(SUM(Topics[dominant_documents]), Topics[topic] = 2)",
            "formatString": "#,0",
            "description": "Dominant topic 2 count; theme is specific to each artist.",
            "displayFolder": "Q12 measures",
            "lineageTag": "1b99b66c-9b0e-56c8-9b18-09e1252d74fd"
          },
          {
            "name": "Topic 3 documents",
            "expression": "CALCULATE(SUM(Topics[dominant_documents]), Topics[topic] = 3)",
            "formatString": "#,0",
            "description": "Dominant topic 3 count; theme is specific to each artist.",
            "displayFolder": "Q12 measures",
            "lineageTag": "6ccde7fa-c7c4-5238-803e-2b1ee4a8c247"
          },
          {
            "name": "Modelled comments",
            "expression": "SUM(Topics[dominant_documents])",
            "formatString": "#,0",
            "description": "Comments retained for LDA; smaller than collected sample.",
            "displayFolder": "Q12 measures",
            "lineageTag": "0392a551-48ec-5444-b9e5-62e490bd53bd"
          },
          {
            "name": "Topic 1 top terms",
            "expression": "CALCULATE(SELECTEDVALUE(Topics[top_terms]), Topics[topic] = 1)",
            "description": "Top words for topic 1 in the hovered artist model; blank when multiple artists have different terms.",
            "displayFolder": "Q12 measures",
            "lineageTag": "83aafa54-db5a-569c-bbee-aeebd657a0af"
          },
          {
            "name": "Topic 2 top terms",
            "expression": "CALCULATE(SELECTEDVALUE(Topics[top_terms]), Topics[topic] = 2)",
            "description": "Top words for topic 2 in the hovered artist model; blank when multiple artists have different terms.",
            "displayFolder": "Q12 measures",
            "lineageTag": "f470fa4f-471d-5212-878e-22ddad3fd71a"
          },
          {
            "name": "Topic 3 top terms",
            "expression": "CALCULATE(SELECTEDVALUE(Topics[top_terms]), Topics[topic] = 3)",
            "description": "Top words for topic 3 in the hovered artist model; blank when multiple artists have different terms.",
            "displayFolder": "Q12 measures",
            "lineageTag": "9695b7e3-3602-5fbf-ad98-5e098fdc0c1a"
          }
        ]
      },
      {
        "name": "Communities",
        "description": "Supplied Communities.csv. Embedded snapshot of the original CSV.",
        "lineageTag": "e36499ba-bcbb-5ff6-9a5a-7a5bf421067f",
        "columns": [
          {
            "name": "artist",
            "dataType": "string",
            "sourceColumn": "artist",
            "lineageTag": "829be7df-2f55-5208-83f2-0ba521ff35a9",
            "summarizeBy": "none"
          },
